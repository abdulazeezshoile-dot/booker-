# --- BizRecord Web (Next.js) ---------------------------------------------
# Copy to .env.local and adjust.

# Base URL of the NestJS backend. Server-side only: the browser never sees it,
# all authenticated calls are proxied through /api/proxy.
API_BASE_URL=http://localhost:3000

# Name of the httpOnly session cookie holding the backend JWT.
SESSION_COOKIE_NAME=bizrecord_session

# Public site URL (used for canonical/OG metadata).
NEXT_PUBLIC_SITE_URL=http://localhost:3001

# Contact address surfaced on the marketing pages.
NEXT_PUBLIC_CONTACT_EMAIL=hello@bizrecord.tech
